# Copy to .env (gitignored). Only needed for the commands noted below.

# `npm run fetch-dict`: Google Sheets API key for the UI dictionary (same as the legacy root .env)
BABAJKA_GOOGLE_API_KEY=

# Backend for `next dev` (default https://api.wir.by); required for `npm run build`
# BACKEND_URL=https://api.wir.by

# Shared secret for POST /revalidate (on-demand cache revalidation from the backend)
# REVALIDATE_SECRET=
