{
  "name": "babajka-frontend-v3",
  "version": "3.0.0-alpha",
  "private": true,
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "next dev --port 3001",
    "prebuild": "node -e \"process.env.BACKEND_URL || (console.error('BACKEND_URL is required: the /api, /auth and /test rewrites are fixed at build time. Use e.g. BACKEND_URL=https://api-prod.wir.by (prod) or https://api.wir.by (dev).'), process.exit(1))\"",
    "build": "next build",
    "postbuild": "cp -R public .next/standalone/ && cp -R .next/static .next/standalone/.next/",
    "start": "PORT=${PORT:-3001} node .next/standalone/server.js",
    "lint": "eslint && prettier --check .",
    "format": "prettier --write . && eslint --fix",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "visual:baseline": "PW_APP=legacy playwright test --update-snapshots",
    "visual:compare": "PW_APP=v3 playwright test",
    "analyze": "next analyze"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.10.0",
    "date-fns": "^4.4.0",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tailwindcss/turbopack": "4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.3.0",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^31.0.0",
    "prettier": "^3.10.0",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "4.3.3",
    "typescript": "^5",
    "vite": "^8.3.8",
    "vitest": "^4.1.12"
  }
}
